{
  "version": 1,
  "sdk_version": "2.2.0",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://vgmbvbajgqzuhjgbrrld.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "smartreach-ai",
      "version": "0.1.0",
      "title": "SmartReach AI"
    },
    "tools": [
      {
        "name": "list_customers",
        "title": "List customers",
        "description": "List customers for the signed-in user's business, newest first.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "limit": {
              "default": 20,
              "description": "How many customers to return.",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "search": {
              "description": "Optional name or phone filter.",
              "type": "string",
              "maxLength": 100
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_products",
        "title": "List products and stock",
        "description": "List the signed-in user's products with price and current stock level.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "limit": {
              "default": 25,
              "description": "How many products to return.",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "lowStockOnly": {
              "default": false,
              "description": "Only return products at or below their reorder level.",
              "type": "boolean"
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_business_health",
        "title": "Get SmartReach score",
        "description": "Get the signed-in user's latest SmartReach business health score and category breakdown.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "create_customer",
        "title": "Create customer",
        "description": "Add a customer to the signed-in user's business.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "description": "Customer name."
            },
            "phone": {
              "description": "Phone number, e.g. +2547....",
              "type": "string",
              "maxLength": 30
            },
            "email": {
              "description": "Email address.",
              "type": "string",
              "maxLength": 160,
              "format": "email",
              "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
            },
            "notes": {
              "description": "Optional internal notes.",
              "type": "string",
              "maxLength": 500
            }
          },
          "required": [
            "name"
          ]
        },
        "outputSchema": null
      }
    ]
  }
}
